{
  "name": "kaki-mahjong-backend",
  "version": "0.1.0",
  "bin": {
    "kaki-mahjong-backend": "dist/bin/app.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-shared-assets.js",
    "watch": "tsc -w",
    "test": "node -r ts-node/register --test test/*.test.ts",
    "test:integration": "npm run build && node --test test/integration.*.test.mjs",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.28.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@kaki/agents": "file:../agents",
    "@kaki/game": "file:../frontend/src/game",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.600.0",
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-polly": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  }
}
